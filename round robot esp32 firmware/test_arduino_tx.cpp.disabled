#include <Arduino.h>
#include "RobotLink.h"
#include "RobotLinkMessages.h"

// Arduino Serial Connection
#define ARDUINO_RX_PIN 26  // ESP32 RX <- Arduino TX
#define ARDUINO_TX_PIN 27  // ESP32 TX -> Arduino RX
#define ARDUINO_BAUD 9600

HardwareSerial arduinoSerial(1);
RobotLink::Link* arduinoLink = nullptr;

uint32_t lastSendTime = 0;
uint32_t sendCount = 0;

void setup() {
  // USB Serial for debugging
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n========================================");
  Serial.println("ESP32 → Arduino TX Test");
  Serial.println("========================================");
  Serial.println("Sending ENABLE_STREAM every 500ms");
  Serial.println("Watch Arduino USB serial for activity!");
  Serial.println("========================================\n");

  // Initialize Arduino Serial
  arduinoSerial.begin(ARDUINO_BAUD, SERIAL_8N1, ARDUINO_RX_PIN, ARDUINO_TX_PIN);
  delay(100);
  Serial.printf("Serial1 initialized: GPIO26(RX) GPIO27(TX) @ %d baud\n\n", ARDUINO_BAUD);

  // Initialize RobotLink protocol
  RobotLink::Config cfg;
  cfg.maxPayload = 64;
  cfg.rejectOversize = true;
  arduinoLink = new RobotLink::Link(arduinoSerial, cfg);

  Serial.println("Starting transmission test...\n");
  lastSendTime = millis();
}

void loop() {
  uint32_t now = millis();

  // Send ENABLE_STREAM command every 500ms
  if (now - lastSendTime >= 500) {
    lastSendTime = now;
    sendCount++;

    // Build ENABLE_STREAM payload
    RobotLink::EnableStreamPayload cmd;
    cmd.enable = 1;
    cmd.intervalMs = 50;

    // Send to Arduino
    bool success = arduinoLink->sendStruct(RobotLink::MSG_ENABLE_STREAM, cmd);

    Serial.printf("[%6lu ms] TX #%lu: ENABLE_STREAM ", now, sendCount);
    Serial.println(success ? "✓ sent" : "✗ FAILED");

    // Print every 10 sends
    if (sendCount % 10 == 0) {
      Serial.printf("\n>>> %lu commands sent so far <<<\n", sendCount);
      Serial.println(">>> Check Arduino USB serial - any activity? <<<\n");
    }
  }

  // Poll for any responses from Arduino
  arduinoLink->poll([](uint8_t type, const uint8_t* payload, uint8_t len) {
    Serial.printf("\n🎯 RX from Arduino! Type=0x%02X Len=%d", type, len);

    // Print payload as hex
    Serial.print(" Data: ");
    for (int i = 0; i < len && i < 20; i++) {
      Serial.printf("%02X ", payload[i]);
    }
    if (len > 20) Serial.print("...");
    Serial.println();
  });

  delay(10);
}
