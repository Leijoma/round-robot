// ESP32 Robot Controller Bridge
// Communicates with Arduino Uno motor controller via RobotLink protocol
// Provides WiFi interface for remote control and odometry streaming
// Integrates Neato XV-11 Lidar with PD-controller for 360-degree scanning

#include <Arduino.h>
#include <WiFi.h>
#include <WiFiUdp.h>
#include "RobotLink.h"
#include "RobotLinkMessages.h"
#include "NeatoLidar.h"

// ============================================================
// Configuration
// ============================================================

// WiFi Configuration (Station mode - connect to existing network)
const char* WIFI_SSID = "SurfsUp";
const char* WIFI_PASSWORD = "MollyLou123!";

// Serial connection to Arduino (Hardware Serial 1 - GPIO26/27)
#define ARDUINO_SERIAL Serial1
#define ARDUINO_RX_PIN 26  // ESP32 RX <- Arduino TX (Arduino D1)
#define ARDUINO_TX_PIN 27  // ESP32 TX -> Arduino RX (Arduino D0)
#define ARDUINO_BAUD 115200

// Lidar Configuration (Neato XV-11)
#define LIDAR_RX_PIN 16      // ESP32 RX <- Lidar TX (Orange wire)
#define LIDAR_PWM_PIN 21     // ESP32 PWM -> Lidar Motor Control
#define LIDAR_TARGET_RPM 220 // Target RPM for lidar motor

// UDP Configuration
const uint16_t UDP_CONTROL_PORT = 5000;  // Receive commands
const uint16_t UDP_ODOM_PORT = 5001;     // Send odometry
const uint16_t UDP_LIDAR_PORT = 5002;    // Send lidar scans

// Failsafe Configuration
const uint32_t COMMAND_TIMEOUT_MS = 2000;  // Auto-stop if no commands for 2 seconds
const uint32_t STARTUP_DELAY_MS = 2000;    // Wait 2 seconds before enabling motors

// ============================================================
// Global Objects
// ============================================================

WiFiUDP udpControl;
WiFiUDP udpOdom;
WiFiUDP udpLidar;
RobotLink::Link* robotLink = nullptr;
NeatoLidar lidar(LIDAR_RX_PIN, LIDAR_PWM_PIN);

// State
struct {
  bool arduinoConnected = false;
  uint32_t lastArduinoMsg = 0;
  uint32_t lastOdomSent = 0;
  uint32_t lastStatusPrint = 0;

  // Latest odometry data
  RobotLink::OdomPayload latestOdom;
  bool odomValid = false;

  // Client address for UDP responses
  IPAddress clientIP;
  uint16_t clientPort = 0;

  // Statistics
  uint32_t framesReceived = 0;
  uint32_t framesSent = 0;
  uint32_t udpCommandsReceived = 0;
  uint32_t udpOdomSent = 0;

  // Failsafe state
  uint32_t lastCommandTime = 0;
  bool motorsEnabled = false;
  bool failsafeTriggered = false;
  uint32_t startupTime = 0;

  // Lidar state
  bool lidarEnabled = false;
  uint32_t lidarScansComplete = 0;
  uint32_t lastLidarSend = 0;
} state;

// ============================================================
// Forward Declarations
// ============================================================

void setupWiFi();
void setupArduino();
void setupLidar();
void processArduinoMessages();
void processLidarData();
void processUDPCommands();
void sendOdomToClients();
void sendLidarData();
void onArduinoFrame(uint8_t type, const uint8_t* payload, uint8_t len);
void onLidarPacket(const NeatoPacket& packet);
void onLidarRevolution(uint32_t totalPackets, uint16_t rpm);
void printStatus();

// ============================================================
// Setup
// ============================================================

void setup() {
  // USB Serial for debugging
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n\n========================================");
  Serial.println("ESP32 Robot Controller Bridge + Lidar");
  Serial.println("========================================\n");

  // Setup WiFi
  setupWiFi();

  // Setup Arduino communication
  setupArduino();

  // Setup Lidar
  setupLidar();

  // FAILSAFE: Send STOP command on startup and wait before enabling motors
  Serial.println("\nFailsafe: Sending STOP command to Arduino...");
  robotLink->sendFrame(RobotLink::MSG_STOP, nullptr, 0);
  delay(100);

  Serial.printf("Failsafe: Motors disabled for %d seconds\n", STARTUP_DELAY_MS / 1000);
  state.startupTime = millis();
  state.motorsEnabled = false;

  Serial.println("\nSystem ready!");
  Serial.println("----------------------------------------");
  Serial.printf("WiFi Network: %s\n", WIFI_SSID);
  Serial.printf("IP Address: %s\n", WiFi.localIP().toString().c_str());
  Serial.printf("UDP Control Port: %d\n", UDP_CONTROL_PORT);
  Serial.printf("UDP Odometry Port: %d\n", UDP_ODOM_PORT);
  Serial.printf("UDP Lidar Port: %d\n", UDP_LIDAR_PORT);
  Serial.printf("Command Timeout: %d ms\n", COMMAND_TIMEOUT_MS);
  Serial.println("----------------------------------------\n");
}

void setupWiFi() {
  Serial.println("Connecting to WiFi network...");

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.printf("  Connecting to: %s\n", WIFI_SSID);

  // Wait for connection (max 20 seconds)
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("  ✓ Connected to WiFi!\n");
    Serial.printf("  ✓ IP Address: %s\n", WiFi.localIP().toString().c_str());
    Serial.printf("  ✓ Signal Strength: %d dBm\n", WiFi.RSSI());

    // Disable WiFi power save for better UDP performance
    WiFi.setSleep(false);
    Serial.println("  ✓ WiFi power save disabled");
  } else {
    Serial.println("  ✗ Failed to connect to WiFi!");
    Serial.println("  ✗ Check SSID and password");
  }

  // Start UDP listeners
  if (udpControl.begin(UDP_CONTROL_PORT)) {
    Serial.printf("  ✓ UDP control listening on port %d\n", UDP_CONTROL_PORT);
  }

  if (udpOdom.begin(UDP_ODOM_PORT)) {
    Serial.printf("  ✓ UDP odometry on port %d\n", UDP_ODOM_PORT);
  }

  if (udpLidar.begin(UDP_LIDAR_PORT)) {
    Serial.printf("  ✓ UDP lidar on port %d\n", UDP_LIDAR_PORT);
  }
}

void setupArduino() {
  Serial.println("Setting up Arduino communication...");

  // Initialize Serial1 for Arduino communication
  ARDUINO_SERIAL.begin(ARDUINO_BAUD, SERIAL_8N1, ARDUINO_RX_PIN, ARDUINO_TX_PIN);

  // Create RobotLink instance
  RobotLink::Config rlConfig;
  rlConfig.maxPayload = 64;
  rlConfig.rejectOversize = true;
  robotLink = new RobotLink::Link(ARDUINO_SERIAL, rlConfig);

  Serial.printf("  ✓ Serial1 configured (RX=%d, TX=%d, %d baud)\n",
                ARDUINO_RX_PIN, ARDUINO_TX_PIN, ARDUINO_BAUD);

  // Wait a bit for Arduino to stabilize
  delay(500);

  // Enable streaming from Arduino (50ms = 20Hz)
  RobotLink::EnableStreamPayload stream;
  stream.enable = 1;
  stream.intervalMs = 50;
  if (robotLink->sendStruct(RobotLink::MSG_ENABLE_STREAM, stream)) {
    Serial.println("  ✓ Enabled odometry streaming from Arduino");
    state.framesSent++;
  }
}

void setupLidar() {
  Serial.println("Setting up Neato Lidar...");

  // Initialize Lidar
  if (!lidar.begin()) {
    Serial.println("  ✗ Failed to initialize Lidar!");
    return;
  }

  // Set callbacks
  lidar.onPacket(onLidarPacket);
  lidar.onRevolution(onLidarRevolution);

  // Enable PD-controller for automatic RPM regulation
  lidar.enableRpmControl(true, LIDAR_TARGET_RPM);

  Serial.printf("  ✓ Lidar initialized on RX=%d, PWM=%d\n", LIDAR_RX_PIN, LIDAR_PWM_PIN);
  Serial.printf("  ✓ PD-controller enabled (target: %d RPM)\n", LIDAR_TARGET_RPM);
  Serial.println("  ✓ Lidar motor DISABLED (use LIDAR_ON command to enable)");
}

// ============================================================
// Main Loop
// ============================================================

void loop() {
  uint32_t now = millis();

  // FAILSAFE: Enable motors after startup delay
  if (!state.motorsEnabled && (now - state.startupTime >= STARTUP_DELAY_MS)) {
    state.motorsEnabled = true;
    Serial.println("✓ Failsafe: Motors enabled");
  }

  // Process messages from Arduino
  processArduinoMessages();

  // Process lidar data
  processLidarData();

  // Process UDP commands from clients
  processUDPCommands();

  // FAILSAFE: Auto-stop if no commands received within timeout
  if (state.motorsEnabled && state.lastCommandTime > 0) {
    if (now - state.lastCommandTime > COMMAND_TIMEOUT_MS) {
      if (!state.failsafeTriggered) {
        Serial.println("⚠ FAILSAFE: Command timeout - sending STOP");
        robotLink->sendFrame(RobotLink::MSG_STOP, nullptr, 0);
        state.failsafeTriggered = true;
      }
    } else {
      // Reset failsafe flag when commands resume
      state.failsafeTriggered = false;
    }
  }

  // Send odometry to UDP clients (if we have recent data)
  if (state.odomValid && (now - state.lastOdomSent >= 50)) {
    sendOdomToClients();
    state.lastOdomSent = now;
  }

  // Send lidar data to UDP clients at 10 Hz
  if (state.lidarEnabled && (now - state.lastLidarSend >= 100)) {
    sendLidarData();
    state.lastLidarSend = now;
  }

  // Check Arduino connection status
  if (state.arduinoConnected && (now - state.lastArduinoMsg > 2000)) {
    state.arduinoConnected = false;
    Serial.println("⚠ Arduino connection lost!");
  }

  // Print status every 5 seconds
  if (now - state.lastStatusPrint >= 5000) {
    printStatus();
    state.lastStatusPrint = now;
  }

  // Small delay to prevent watchdog issues
  delay(1);
}

// ============================================================
// Arduino Communication
// ============================================================

void processArduinoMessages() {
  // Poll RobotLink for incoming frames
  if (robotLink->poll(onArduinoFrame)) {
    state.lastArduinoMsg = millis();
    if (!state.arduinoConnected) {
      state.arduinoConnected = true;
      Serial.println("✓ Arduino connected!");
    }
  }
}

void onArduinoFrame(uint8_t type, const uint8_t* payload, uint8_t len) {
  state.framesReceived++;

  switch (type) {
    case RobotLink::MSG_ODOM: {
      if (len == sizeof(RobotLink::OdomPayload)) {
        memcpy(&state.latestOdom, payload, sizeof(RobotLink::OdomPayload));
        state.odomValid = true;
      }
      break;
    }

    case RobotLink::MSG_STATUS: {
      Serial.println("Received STATUS from Arduino");
      break;
    }

    case RobotLink::MSG_CONFIG_RESP: {
      Serial.println("Received CONFIG from Arduino");
      break;
    }

    case RobotLink::MSG_PONG: {
      Serial.println("Received PONG from Arduino");
      break;
    }

    default:
      Serial.printf("Received unknown message type: 0x%02X\n", type);
      break;
  }
}

// ============================================================
// Lidar Processing
// ============================================================

void processLidarData() {
  // Update lidar (processes serial data, updates PD-controller)
  lidar.update();
}

void onLidarPacket(const NeatoPacket& packet) {
  // Packet received callback (can be used for real-time processing)
  // For now, we'll send aggregated data via sendLidarData()
}

void onLidarRevolution(uint32_t totalPackets, uint16_t rpm) {
  state.lidarScansComplete++;
}

void sendLidarData() {
  if (!state.lidarEnabled || state.clientIP == IPAddress(0, 0, 0, 0)) {
    return;
  }

  // Send lidar status and current RPM
  char buffer[128];
  snprintf(buffer, sizeof(buffer),
           "LIDAR RPM=%u TARGET=%u PACKETS=%lu INVALID=%lu SCANS=%lu\n",
           lidar.getCurrentRpm(),
           lidar.getTargetRpm(),
           lidar.getPacketsReceived(),
           lidar.getPacketsInvalid(),
           state.lidarScansComplete);

  udpLidar.beginPacket(state.clientIP, UDP_LIDAR_PORT);
  udpLidar.write((const uint8_t*)buffer, strlen(buffer));
  udpLidar.endPacket();
}

// ============================================================
// UDP Command Processing
// ============================================================

void processUDPCommands() {
  int packetSize = udpControl.parsePacket();
  if (packetSize == 0) return;

  state.udpCommandsReceived++;

  // Store client address for responses
  state.clientIP = udpControl.remoteIP();
  state.clientPort = udpControl.remotePort();

  // Read packet
  uint8_t buffer[256];
  int len = udpControl.read(buffer, sizeof(buffer));

  if (len < 1) return;

  // Simple text protocol
  // Format: "CMD param1 param2 ..."
  buffer[len] = '\0';
  String cmd = String((char*)buffer);
  cmd.trim();
  cmd.toUpperCase();

  Serial.printf("UDP Command from %s:%d: %s\n",
                state.clientIP.toString().c_str(), state.clientPort, cmd.c_str());

  // Update command watchdog timestamp
  state.lastCommandTime = millis();

  // FAILSAFE: Block motor commands during startup delay
  if (!state.motorsEnabled && (cmd.startsWith("VEL ") || cmd.startsWith("L ") || cmd.startsWith("R "))) {
    Serial.println("  ⚠ FAILSAFE: Motors disabled during startup - command ignored");
    return;
  }

  // Parse and forward to Arduino
  if (cmd.startsWith("VEL ")) {
    // VEL left right (e.g., "VEL 0.3 0.3")
    float left = 0, right = 0;
    if (sscanf(cmd.c_str(), "VEL %f %f", &left, &right) == 2) {
      RobotLink::SetVelPayload vel;
      vel.velLeft = left;
      vel.velRight = right;
      if (robotLink->sendStruct(RobotLink::MSG_SET_VEL, vel)) {
        state.framesSent++;
        Serial.printf("  → Arduino: Set velocity L=%.2f R=%.2f\n", left, right);
      }
    }
  }
  else if (cmd.startsWith("PID ")) {
    // PID Kp Ki Kd
    float Kp = 0, Ki = 0, Kd = 0;
    if (sscanf(cmd.c_str(), "PID %f %f %f", &Kp, &Ki, &Kd) == 3) {
      RobotLink::SetPidPayload pid;
      pid.Kp = Kp;
      pid.Ki = Ki;
      pid.Kd = Kd;
      if (robotLink->sendStruct(RobotLink::MSG_SET_PID, pid)) {
        state.framesSent++;
        Serial.printf("  → Arduino: Set PID Kp=%.2f Ki=%.2f Kd=%.2f\n", Kp, Ki, Kd);
      }
    }
  }
  else if (cmd == "STOP") {
    if (robotLink->sendFrame(RobotLink::MSG_STOP, nullptr, 0)) {
      state.framesSent++;
      Serial.println("  → Arduino: STOP");
    }
  }
  else if (cmd == "ZERO") {
    if (robotLink->sendFrame(RobotLink::MSG_ZERO_ENCODERS, nullptr, 0)) {
      state.framesSent++;
      Serial.println("  → Arduino: ZERO ENCODERS");
    }
  }
  else if (cmd == "STATUS") {
    if (robotLink->sendFrame(RobotLink::MSG_GET_CONFIG, nullptr, 0)) {
      state.framesSent++;
      Serial.println("  → Arduino: GET STATUS");
    }
  }
  else if (cmd == "SAVE") {
    if (robotLink->sendFrame(RobotLink::MSG_SAVE_CONFIG, nullptr, 0)) {
      state.framesSent++;
      Serial.println("  → Arduino: SAVE CONFIG");
    }
  }
  // ==== Lidar Commands ====
  else if (cmd == "LIDAR_ON") {
    lidar.startMotor(255);  // Start motor (PD-controller will adjust to target RPM)
    state.lidarEnabled = true;
    Serial.println("  → Lidar: MOTOR ON (PD-controller enabled)");
  }
  else if (cmd == "LIDAR_OFF") {
    lidar.stopMotor();
    state.lidarEnabled = false;
    Serial.println("  → Lidar: MOTOR OFF");
  }
  else if (cmd.startsWith("LIDAR_PWM ")) {
    uint8_t pwm = 0;
    if (sscanf(cmd.c_str(), "LIDAR_PWM %hhu", &pwm) == 1) {
      lidar.setMotorSpeed(pwm);
      Serial.printf("  → Lidar: Set PWM to %u\n", pwm);
    }
  }
  else if (cmd.startsWith("LIDAR_RPM ")) {
    uint16_t rpm = 0;
    if (sscanf(cmd.c_str(), "LIDAR_RPM %hu", &rpm) == 1) {
      lidar.enableRpmControl(true, rpm);
      Serial.printf("  → Lidar: Set target RPM to %u\n", rpm);
    }
  }
  else {
    Serial.printf("  ✗ Unknown command: %s\n", cmd.c_str());
  }
}

// ============================================================
// UDP Odometry Streaming
// ============================================================

void sendOdomToClients() {
  if (!state.odomValid || state.clientIP == IPAddress(0, 0, 0, 0)) {
    return;  // No data or no client connected yet
  }

  // Send as simple text format
  // Format: "ODOM encL encR velL velR pwmL pwmR timestamp"
  char buffer[128];
  snprintf(buffer, sizeof(buffer),
           "ODOM %ld %ld %.3f %.3f %d %d %u\n",
           state.latestOdom.encoderLeft,
           state.latestOdom.encoderRight,
           state.latestOdom.velLeft,
           state.latestOdom.velRight,
           state.latestOdom.pwmLeft,
           state.latestOdom.pwmRight,
           state.latestOdom.timestamp);

  // Send to last known client
  udpOdom.beginPacket(state.clientIP, UDP_ODOM_PORT);
  udpOdom.write((const uint8_t*)buffer, strlen(buffer));
  udpOdom.endPacket();

  state.udpOdomSent++;
}

// ============================================================
// Status Reporting
// ============================================================

void printStatus() {
  Serial.println("\n========== STATUS ==========");
  Serial.printf("Arduino: %s\n", state.arduinoConnected ? "CONNECTED" : "DISCONNECTED");
  Serial.printf("WiFi: %s (%d dBm)\n",
                WiFi.status() == WL_CONNECTED ? "CONNECTED" : "DISCONNECTED",
                WiFi.RSSI());

  if (state.clientIP != IPAddress(0, 0, 0, 0)) {
    Serial.printf("UDP Client: %s:%d\n",
                  state.clientIP.toString().c_str(), state.clientPort);
  }

  if (state.odomValid) {
    Serial.printf("Latest Odom:\n");
    Serial.printf("  Encoders: L=%ld R=%ld\n",
                  state.latestOdom.encoderLeft, state.latestOdom.encoderRight);
    Serial.printf("  Velocity: L=%.3f R=%.3f m/s\n",
                  state.latestOdom.velLeft, state.latestOdom.velRight);
    Serial.printf("  PWM: L=%d R=%d\n",
                  state.latestOdom.pwmLeft, state.latestOdom.pwmRight);
  }

  Serial.printf("Stats:\n");
  Serial.printf("  Frames RX: %u  TX: %u\n", state.framesReceived, state.framesSent);
  Serial.printf("  UDP RX: %u  TX: %u\n", state.udpCommandsReceived, state.udpOdomSent);
  Serial.printf("  RobotLink: OK=%u BadCRC=%u BadLen=%u\n",
                robotLink->framesOk(), robotLink->framesBadCrc(), robotLink->framesBadLen());

  if (state.lidarEnabled) {
    Serial.printf("Lidar:\n");
    Serial.printf("  Motor: %s  RPM: %u/%u  PWM: %u\n",
                  lidar.isMotorRunning() ? "ON" : "OFF",
                  lidar.getCurrentRpm(),
                  lidar.getTargetRpm(),
                  lidar.getMotorSpeed());
    Serial.printf("  Scans: %u  Packets: %lu (%lu invalid)\n",
                  state.lidarScansComplete,
                  lidar.getPacketsReceived(),
                  lidar.getPacketsInvalid());
  }

  Serial.println("============================\n");
}
