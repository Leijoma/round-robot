// ESP32 Robot Controller Bridge
// Communicates with Arduino Uno motor controller via RobotLink protocol over Serial
// Provides WiFi interface via RobotLink protocol over UDP
// Integrates Neato XV-11 Lidar with PD-controller for 360-degree scanning

#include <Arduino.h>
#include <WiFi.h>
#include <WiFiUdp.h>
#include "RobotLink.h"
#include "RobotLinkMessages.h"
#include "RobotLinkUDP.h"
#include "NeatoLidar.h"

// ============================================================
// Configuration  
// ============================================================

// WiFi Configuration (Station mode - connect to existing network)
const char* WIFI_SSID = "SurfsUp";
const char* WIFI_PASSWORD = "MollyLou123!";

// Serial connection to Arduino (Hardware Serial 1 - GPIO26/27)
#define ARDUINO_SERIAL Serial1
#define ARDUINO_RX_PIN 26  // ESP32 RX <- Arduino TX (Arduino D1)
#define ARDUINO_TX_PIN 27  // ESP32 TX -> Arduino RX (Arduino D0)
#define ARDUINO_BAUD 115200

// Lidar Configuration (Neato XV-11)
#define LIDAR_RX_PIN 16      // ESP32 RX <- Lidar TX (Orange wire)
#define LIDAR_PWM_PIN 21     // ESP32 PWM -> Lidar Motor Control
#define LIDAR_TARGET_RPM 220 // Target RPM for lidar motor

// UDP Configuration
const uint16_t UDP_PORT = 5000;  // Single port for all RobotLink communication

// Failsafe Configuration
const uint32_t COMMAND_TIMEOUT_MS = 2000;  // Auto-stop if no commands for 2 seconds
const uint32_t STARTUP_DELAY_MS = 2000;    // Wait 2 seconds before enabling motors

// ============================================================
// Global Objects
// ============================================================

WiFiUDP udp;
RobotLink::UDPStream* udpStream = nullptr;
RobotLink::Link* hostLink = nullptr;      // ESP32 <-> Host (UDP)
RobotLink::Link* arduinoLink = nullptr;   // ESP32 <-> Arduino (Serial)
NeatoLidar lidar(LIDAR_RX_PIN, LIDAR_PWM_PIN);

// State
struct {
  bool arduinoConnected = false;
  uint32_t lastArduinoMsg = 0;
  uint32_t lastHostMsg = 0;
  uint32_t lastStatusPrint = 0;
  uint32_t lastOdomSent = 0;
  uint32_t lastLidarStatusSent = 0;

  // Latest odometry data
  RobotLink::OdomPayload latestOdom;
  bool odomValid = false;

  // Statistics
  uint32_t arduinoFramesRx = 0;
  uint32_t arduinoFramesTx = 0;
  uint32_t hostFramesRx = 0;
  uint32_t hostFramesTx = 0;

  // Failsafe state
  uint32_t lastCommandTime = 0;
  bool motorsEnabled = false;
  bool failsafeTriggered = false;
  uint32_t startupTime = 0;

  // Lidar state
  bool lidarEnabled = false;
  uint32_t lidarScansComplete = 0;
} state;

// ============================================================
// Forward Declarations
// ============================================================

void setupWiFi();
void setupArduino();
void setupHost();
void setupLidar();
void processArduinoMessages();
void processHostMessages();
void processLidarData();
void sendOdomToHost();
void sendLidarStatusToHost();
void onArduinoFrame(uint8_t type, const uint8_t* payload, uint8_t len);
void onHostFrame(uint8_t type, const uint8_t* payload, uint8_t len);
void onLidarPacket(const NeatoPacket& packet);
void onLidarRevolution(uint32_t totalPackets, uint16_t rpm);
void printStatus();

// ============================================================
// Setup
// ============================================================

void setup() {
  // USB Serial for debugging
  Serial.begin(115200);
  delay(1000);

  Serial.println("\n\n========================================");
  Serial.println("ESP32 Robot Controller Bridge + Lidar");
  Serial.println("RobotLink Protocol over UDP");
  Serial.println("========================================\n");

  // Setup WiFi
  setupWiFi();

  // Setup Host communication (UDP)
  setupHost();

  // Setup Arduino communication (Serial)
  setupArduino();

  // Setup Lidar
  setupLidar();

  // FAILSAFE: Send STOP command on startup and wait before enabling motors
  Serial.println("\nFailsafe: Sending STOP command to Arduino...");
  arduinoLink->sendFrame(RobotLink::MSG_STOP, nullptr, 0);
  delay(100);

  Serial.printf("Failsafe: Motors disabled for %d seconds\n", STARTUP_DELAY_MS / 1000);
  state.startupTime = millis();
  state.motorsEnabled = false;

  Serial.println("\nSystem ready!");
  Serial.println("----------------------------------------");
  Serial.printf("WiFi Network: %s\n", WIFI_SSID);
  Serial.printf("IP Address: %s\n", WiFi.localIP().toString().c_str());
  Serial.printf("UDP Port: %d (RobotLink protocol)\n", UDP_PORT);
  Serial.printf("Command Timeout: %d ms\n", COMMAND_TIMEOUT_MS);
  Serial.println("----------------------------------------\n");
}

void setupWiFi() {
  Serial.println("Connecting to WiFi network...");

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.printf("  Connecting to: %s\n", WIFI_SSID);

  // Wait for connection (max 20 seconds)
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  Serial.println();

  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("  ✓ Connected to WiFi!\n");
    Serial.printf("  ✓ IP Address: %s\n", WiFi.localIP().toString().c_str());
    Serial.printf("  ✓ Signal Strength: %d dBm\n", WiFi.RSSI());

    // Disable WiFi power save for better UDP performance
    WiFi.setSleep(false);
    Serial.println("  ✓ WiFi power save disabled");
  } else {
    Serial.println("  ✗ Failed to connect to WiFi!");
    Serial.println("  ✗ Check SSID and password");
  }
}

void setupHost() {
  Serial.println("Setting up Host communication (UDP)...");

  // Start UDP
  if (udp.begin(UDP_PORT)) {
    Serial.printf("  ✓ UDP listening on port %d\n", UDP_PORT);
  }

  // Create UDP stream wrapper
  udpStream = new RobotLink::UDPStream(udp);

  // Create RobotLink instance for host communication
  RobotLink::Config rlConfig;
  rlConfig.maxPayload = 255;  // Larger for lidar data
  rlConfig.rejectOversize = true;
  hostLink = new RobotLink::Link(*udpStream, rlConfig);

  Serial.println("  ✓ RobotLink protocol initialized for UDP");
}

void setupArduino() {
  Serial.println("Setting up Arduino communication (Serial)...");

  // Initialize Serial1 for Arduino communication
  ARDUINO_SERIAL.begin(ARDUINO_BAUD, SERIAL_8N1, ARDUINO_RX_PIN, ARDUINO_TX_PIN);

  // Create RobotLink instance
  RobotLink::Config rlConfig;
  rlConfig.maxPayload = 64;
  rlConfig.rejectOversize = true;
  arduinoLink = new RobotLink::Link(ARDUINO_SERIAL, rlConfig);

  Serial.printf("  ✓ Serial1 configured (RX=%d, TX=%d, %d baud)\n",
                ARDUINO_RX_PIN, ARDUINO_TX_PIN, ARDUINO_BAUD);

  // Wait a bit for Arduino to stabilize
  delay(500);

  // Enable streaming from Arduino (50ms = 20Hz)
  RobotLink::EnableStreamPayload stream;
  stream.enable = 1;
  stream.intervalMs = 50;
  if (arduinoLink->sendStruct(RobotLink::MSG_ENABLE_STREAM, stream)) {
    Serial.println("  ✓ Enabled odometry streaming from Arduino");
    state.arduinoFramesTx++;
  }
}

void setupLidar() {
  Serial.println("Setting up Neato Lidar...");

  // Initialize Lidar
  if (!lidar.begin()) {
    Serial.println("  ✗ Failed to initialize Lidar!");
    return;
  }

  // Set callbacks
  lidar.onPacket(onLidarPacket);
  lidar.onRevolution(onLidarRevolution);

  // Enable PD-controller for automatic RPM regulation
  lidar.enableRpmControl(true, LIDAR_TARGET_RPM);

  Serial.printf("  ✓ Lidar initialized on RX=%d, PWM=%d\n", LIDAR_RX_PIN, LIDAR_PWM_PIN);
  Serial.printf("  ✓ PD-controller enabled (target: %d RPM)\n", LIDAR_TARGET_RPM);
  Serial.println("  ✓ Lidar motor DISABLED (send MSG_LIDAR_ENABLE to enable)");
}

// ============================================================
// Main Loop
// ============================================================

void loop() {
  uint32_t now = millis();

  // FAILSAFE: Enable motors after startup delay
  if (!state.motorsEnabled && (now - state.startupTime >= STARTUP_DELAY_MS)) {
    state.motorsEnabled = true;
    Serial.println("✓ Failsafe: Motors enabled");
  }

  // Process messages from Arduino
  processArduinoMessages();

  // Process messages from Host
  processHostMessages();

  // Process lidar data
  processLidarData();

  // FAILSAFE: Auto-stop if no commands received within timeout
  if (state.motorsEnabled && state.lastCommandTime > 0) {
    if (now - state.lastCommandTime > COMMAND_TIMEOUT_MS) {
      if (!state.failsafeTriggered) {
        Serial.println("⚠ FAILSAFE: Command timeout - sending STOP");
        arduinoLink->sendFrame(RobotLink::MSG_STOP, nullptr, 0);
        state.failsafeTriggered = true;
      }
    } else {
      // Reset failsafe flag when commands resume
      state.failsafeTriggered = false;
    }
  }

  // Send odometry to host at 20 Hz (if we have recent data and a client)
  if (state.odomValid && udpStream->hasClient() && (now - state.lastOdomSent >= 50)) {
    sendOdomToHost();
    state.lastOdomSent = now;
  }

  // Send lidar status to host at 5 Hz
  if (state.lidarEnabled && udpStream->hasClient() && (now - state.lastLidarStatusSent >= 200)) {
    sendLidarStatusToHost();
    state.lastLidarStatusSent = now;
  }

  // Check Arduino connection status
  if (state.arduinoConnected && (now - state.lastArduinoMsg > 2000)) {
    state.arduinoConnected = false;
    Serial.println("⚠ Arduino connection lost!");
  }

  // Print status every 5 seconds
  if (now - state.lastStatusPrint >= 5000) {
    printStatus();
    state.lastStatusPrint = now;
  }

  // Small delay to prevent watchdog issues
  delay(1);
}

// ============================================================
// Arduino Communication
// ============================================================

void processArduinoMessages() {
  // Poll RobotLink for incoming frames
  if (arduinoLink->poll(onArduinoFrame)) {
    state.lastArduinoMsg = millis();
    if (!state.arduinoConnected) {
      state.arduinoConnected = true;
      Serial.println("✓ Arduino connected!");
    }
  }
}

void onArduinoFrame(uint8_t type, const uint8_t* payload, uint8_t len) {
  state.arduinoFramesRx++;

  switch (type) {
    case RobotLink::MSG_ODOM: {
      if (len == sizeof(RobotLink::OdomPayload)) {
        memcpy(&state.latestOdom, payload, sizeof(RobotLink::OdomPayload));
        state.odomValid = true;
      }
      break;
    }

    case RobotLink::MSG_STATUS:
    case RobotLink::MSG_CONFIG_RESP:
    case RobotLink::MSG_PONG: {
      // Forward these to host if connected
      if (udpStream->hasClient()) {
        hostLink->sendFrame(type, payload, len);
        state.hostFramesTx++;
      }
      break;
    }

    default:
      Serial.printf("[Arduino] Unknown message type: 0x%02X\n", type);
      break;
  }
}

// ============================================================
// Host Communication (UDP)
// ============================================================

void processHostMessages() {
  // Poll RobotLink for incoming frames over UDP
  if (hostLink->poll(onHostFrame)) {
    state.lastHostMsg = millis();
  }
}

void onHostFrame(uint8_t type, const uint8_t* payload, uint8_t len) {
  state.hostFramesRx++;
  Serial.printf("[Host] Frame RX: type=0x%02X len=%d\n", type, len);

  // Update command watchdog timestamp for motor commands
  if (type == RobotLink::MSG_CMD_VEL || type == RobotLink::MSG_SET_VEL || type == RobotLink::MSG_STOP) {
    state.lastCommandTime = millis();
  }

  // FAILSAFE: Block motor commands during startup delay
  if (!state.motorsEnabled && (type == RobotLink::MSG_CMD_VEL || type == RobotLink::MSG_SET_VEL)) {
    Serial.println("[Host] ⚠ FAILSAFE: Motors disabled during startup - command ignored");
    return;
  }

  switch (type) {
    // ========== Motor Control Messages (forward to Arduino) ==========
    case RobotLink::MSG_CMD_VEL:  // 0x02 - (v, w) velocity command for Arduino
    case RobotLink::MSG_SET_VEL:
    case RobotLink::MSG_SET_PID:
    case RobotLink::MSG_SET_DEADBAND:
    case RobotLink::MSG_SET_CONFIG:
    case RobotLink::MSG_ENABLE_STREAM:
    case RobotLink::MSG_GET_CONFIG:
    case RobotLink::MSG_SAVE_CONFIG:
    case RobotLink::MSG_LOAD_CONFIG:
    case RobotLink::MSG_ZERO_ENCODERS:
    case RobotLink::MSG_STOP: {
      // Forward to Arduino
      Serial.printf("[Host→Arduino] Forwarding type=0x%02X len=%d\n", type, len);
      if (arduinoLink->sendFrame(type, payload, len)) {
        state.arduinoFramesTx++;
        Serial.println("  ✓ Sent to Arduino");
      } else {
        Serial.println("  ✗ Failed to send");
      }
      break;
    }

    // ========== Lidar Control Messages ==========
    case RobotLink::MSG_LIDAR_ENABLE: {
      if (len == sizeof(RobotLink::LidarEnablePayload)) {
        RobotLink::LidarEnablePayload* cmd = (RobotLink::LidarEnablePayload*)payload;
        if (cmd->enable) {
          lidar.startMotor(255);  // PD-controller will adjust to target RPM
          state.lidarEnabled = true;
          Serial.println("[Host] Lidar motor ENABLED");
        } else {
          lidar.stopMotor();
          state.lidarEnabled = false;
          Serial.println("[Host] Lidar motor DISABLED");
        }
      }
      break;
    }

    case RobotLink::MSG_LIDAR_SET_RPM: {
      if (len == sizeof(RobotLink::LidarSetRpmPayload)) {
        RobotLink::LidarSetRpmPayload* cmd = (RobotLink::LidarSetRpmPayload*)payload;
        lidar.enableRpmControl(true, cmd->targetRpm);
        Serial.printf("[Host] Lidar target RPM set to %u\n", cmd->targetRpm);
      }
      break;
    }

    // ========== Ping/Pong ==========
    case RobotLink::MSG_PING: {
      // Echo back as PONG
      hostLink->sendFrame(RobotLink::MSG_PONG, payload, len);
      state.hostFramesTx++;
      break;
    }

    default:
      Serial.printf("[Host] Unknown message type: 0x%02X\n", type);
      break;
  }
}

void sendOdomToHost() {
  if (hostLink->sendStruct(RobotLink::MSG_ODOM, state.latestOdom)) {
    state.hostFramesTx++;
  }
}

void sendLidarStatusToHost() {
  RobotLink::LidarStatusPayload status;
  status.currentRpm = lidar.getCurrentRpm();
  status.targetRpm = lidar.getTargetRpm();
  status.motorRunning = lidar.isMotorRunning() ? 1 : 0;
  status.rpmControlEnabled = 1;  // PD-controller always enabled
  status.motorSpeed = lidar.getMotorSpeed();
  status.reserved = 0;
  status.packetsReceived = lidar.getPacketsReceived();
  status.packetsInvalid = lidar.getPacketsInvalid();
  status.scansComplete = state.lidarScansComplete;
  status.timestamp = millis();

  if (hostLink->sendStruct(RobotLink::MSG_LIDAR_STATUS, status)) {
    state.hostFramesTx++;
  }
}

// ============================================================
// Lidar Processing
// ============================================================

void processLidarData() {
  // Update lidar (processes serial data, updates PD-controller)
  lidar.update();
}

void onLidarPacket(const NeatoPacket& packet) {
  // Packet received callback
  // Could send individual packets or aggregate into full scans
  // For now, we'll just send status updates
}

void onLidarRevolution(uint32_t totalPackets, uint16_t rpm) {
  state.lidarScansComplete++;
}

// ============================================================
// Status Reporting
// ============================================================

void printStatus() {
  Serial.println("\n========== STATUS ==========");
  Serial.printf("Arduino: %s\n", state.arduinoConnected ? "CONNECTED" : "DISCONNECTED");
  Serial.printf("WiFi: %s (%d dBm)\n",
                WiFi.status() == WL_CONNECTED ? "CONNECTED" : "DISCONNECTED",
                WiFi.RSSI());

  if (udpStream->hasClient()) {
    Serial.printf("UDP Client: %s:%d\n",
                  udpStream->getClientIP().toString().c_str(),
                  udpStream->getClientPort());
  } else {
    Serial.println("UDP Client: NONE");
  }

  if (state.odomValid) {
    Serial.printf("Latest Odom:\n");
    Serial.printf("  Encoders: L=%ld R=%ld\n",
                  state.latestOdom.encoderLeft, state.latestOdom.encoderRight);
    Serial.printf("  Velocity: L=%.3f R=%.3f m/s\n",
                  state.latestOdom.velLeft, state.latestOdom.velRight);
    Serial.printf("  PWM: L=%d R=%d\n",
                  state.latestOdom.pwmLeft, state.latestOdom.pwmRight);
  }

  Serial.printf("Stats:\n");
  Serial.printf("  Arduino: RX=%u TX=%u (OK=%u BadCRC=%u)\n",
                state.arduinoFramesRx, state.arduinoFramesTx,
                arduinoLink->framesOk(), arduinoLink->framesBadCrc());
  Serial.printf("  Host: RX=%u TX=%u (OK=%u BadCRC=%u)\n",
                state.hostFramesRx, state.hostFramesTx,
                hostLink->framesOk(), hostLink->framesBadCrc());

  if (state.lidarEnabled) {
    Serial.printf("Lidar:\n");
    Serial.printf("  Motor: %s  RPM: %u/%u  PWM: %u\n",
                  lidar.isMotorRunning() ? "ON" : "OFF",
                  lidar.getCurrentRpm(),
                  lidar.getTargetRpm(),
                  lidar.getMotorSpeed());
    Serial.printf("  Scans: %u  Packets: %lu (%lu invalid)\n",
                  state.lidarScansComplete,
                  lidar.getPacketsReceived(),
                  lidar.getPacketsInvalid());
  }

  Serial.println("============================\n");
}
